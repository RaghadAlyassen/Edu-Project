@model Edu_Project.Models.QuizGrade

@{
    ViewData["Title"] = "Quiz Result";

    var quiz =
        ViewBag.Quiz as Edu_Project.Models.Quiz;

    var totalMarks =
        quiz?.TotalMarks ?? 0;

    var percentage =
        totalMarks == 0
            ? 0
            : (Model.Grade * 100) / totalMarks;

    var passed =
        percentage >= 50;
}

<section class="edu-page-section">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-8">

                <div class="quiz-result-card">

                    <div class="quiz-result-header @(passed ? "passed" : "failed")">

                        <div class="quiz-result-status-icon">
                            @(passed ? "✓" : "!")
                        </div>

                        <span class="dashboard-panel-label">
                            Quiz Result
                        </span>

                        <h1>
                            @(passed
                                ? "Congratulations!"
                                : "Quiz Completed")
                        </h1>

                        <p>
                            @(passed
                                ? "You successfully passed this quiz."
                                : "You completed the quiz, but your score is below the passing mark.")
                        </p>

                    </div>

                    <div class="quiz-result-body">

                        @if (quiz != null)
                        {
                            <div class="quiz-result-title">

                                <span>
                                    Quiz
                                </span>

                                <h2>
                                    @quiz.Title
                                </h2>

                            </div>
                        }

                        <div class="quiz-result-score-area">

                            <div class="quiz-result-score-circle @(passed ? "passed" : "failed")">

                                <span class="quiz-result-percentage">
                                    @percentage%
                                </span>

                                <span class="quiz-result-score-label">
                                    Score
                                </span>

                            </div>

                            <div class="quiz-result-score-details">

                                <div class="quiz-result-score-item">

                                    <span>
                                        Your Grade
                                    </span>

                                    <strong>
                                        @Model.Grade
                                    </strong>

                                </div>

                                <div class="quiz-result-score-item">

                                    <span>
                                        Total Marks
                                    </span>

                                    <strong>
                                        @totalMarks
                                    </strong>

                                </div>

                                <div class="quiz-result-score-item">

                                    <span>
                                        Result
                                    </span>

                                    <strong class="@(passed ? "quiz-result-pass-text" : "quiz-result-fail-text")">
                                        @(passed ? "Passed" : "Not Passed")
                                    </strong>

                                </div>

                            </div>

                        </div>

                        <div class="quiz-result-message @(passed ? "passed" : "failed")">

                            <div class="quiz-result-message-icon">
                                @(passed ? "✓" : "!")
                            </div>

                            <div>

                                <strong>
                                    @(passed
                                        ? "Great job!"
                                        : "Keep learning!")
                                </strong>

                                <p>
                                    @(passed
                                        ? "You achieved the required passing score for this quiz."
                                        : "Review the lesson content and continue improving your understanding.")
                                </p>

                            </div>

                        </div>

                        <div class="quiz-result-actions">

                            <a asp-controller="Quiz"
                               asp-action="MyGrades"
                               class="btn edu-btn-primary">

                                My Quiz Grades

                            </a>

                            <a asp-controller="Enrollment"
                               asp-action="MyCourses"
                               class="btn edu-btn-outline">

                                Back to My Courses

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>