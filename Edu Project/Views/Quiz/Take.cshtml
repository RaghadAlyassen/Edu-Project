@model Edu_Project.Models.Quiz

@{
    ViewData["Title"] = "Take Quiz";

    var totalQuestions =
        Model.Questions?.Count ?? 0;
}

<section class="edu-page-section">

    <div class="container">

        <div class="edu-page-header">

            <span class="edu-hero-badge">
                Quiz
            </span>

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3">

                <div>

                    <h1 class="edu-page-title">
                        @Model.Title
                    </h1>

                    <p class="edu-page-subtitle mb-0">
                        Answer all questions, then submit your quiz to view your result.
                    </p>

                </div>

            </div>

        </div>

        <div class="student-quiz-summary">

            <div class="student-quiz-summary-main">

                <div class="quiz-summary-icon">
                    Q
                </div>

                <div>

                    <span class="dashboard-panel-label">
                        Quiz Overview
                    </span>

                    <h2>
                        @Model.Title
                    </h2>

                    <p>
                        Complete all @totalQuestions questions before submitting.
                    </p>

                </div>

            </div>

            <div class="quiz-summary-stats">

                <div class="quiz-summary-stat">

                    <span>
                        Duration
                    </span>

                    <strong>
                        @Model.Duration min
                    </strong>

                </div>

                <div class="quiz-summary-stat">

                    <span>
                        Total Marks
                    </span>

                    <strong>
                        @Model.TotalMarks
                    </strong>

                </div>

                <div class="quiz-summary-stat">

                    <span>
                        Questions
                    </span>

                    <strong>
                        @totalQuestions
                    </strong>

                </div>

            </div>

        </div>

        @if (Model.Questions == null ||
             !Model.Questions.Any())
        {
            <div class="dashboard-panel">

                <div class="dashboard-empty-state">

                    <div class="dashboard-empty-icon">
                        Q
                    </div>

                    <h4>
                        No questions available
                    </h4>

                    <p>
                        This quiz does not contain any questions yet.
                    </p>

                </div>

            </div>
        }
        else
        {
            <form asp-controller="Quiz"
                  asp-action="Submit"
                  method="post"
                  id="quizForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="quizId"
                       value="@Model.Id" />

                @{
                    var questionNumber = 1;
                }

                <div class="student-quiz-question-list">

                    @foreach (var question in Model.Questions)
                    {
                        var answers =
                            question.Answers?.ToList()
                            ?? new List<Edu_Project.Models.Answer>();

                        <div class="student-quiz-question-card">

                            <div class="student-quiz-question-header">

                                <div class="quiz-question-number">
                                    @questionNumber
                                </div>

                                <div>

                                    <span class="quiz-question-label">
                                        Question @questionNumber
                                    </span>

                                    <h2>
                                        @question.Text
                                    </h2>

                                </div>

                            </div>

                            @if (answers.Any())
                            {
                                <div class="student-quiz-answer-list">

                                    @for (var i = 0;
                                          i < answers.Count;
                                          i++)
                                    {
                                        var answer =
                                            answers[i];

                                        var answerLetter =
                                            i == 0 ? "A" :
                                            i == 1 ? "B" :
                                            i == 2 ? "C" : "D";

                                        <label class="student-quiz-answer-option"
                                               for="answer_@answer.Id">

                                            <input class="form-check-input"
                                                   type="radio"
                                                   name="answers[@question.Id]"
                                                   value="@answer.Id"
                                                   id="answer_@answer.Id"
                                                   required />

                                            <span class="student-quiz-answer-letter">
                                                @answerLetter
                                            </span>

                                            <span class="student-quiz-answer-text">
                                                @answer.Text
                                            </span>

                                        </label>
                                    }

                                </div>
                            }
                            else
                            {
                                <div class="quiz-no-answers">
                                    No answers are available for this question.
                                </div>
                            }

                        </div>

                        questionNumber++;
                    }

                </div>

                <div class="student-quiz-submit-card">

                    <div>

                        <span class="lesson-form-next-label">
                            Finish Quiz
                        </span>

                        <strong>
                            Ready to submit?
                        </strong>

                        <p>
                            Make sure you answered every question before submitting.
                        </p>

                    </div>

                    <button type="submit"
                            class="btn edu-btn-primary"
                            onclick="return confirm('Are you sure you want to submit this quiz?');">

                        Submit Quiz
                        <span class="ms-1">
                            →
                        </span>

                    </button>

                </div>

            </form>
        }

    </div>

</section>