@model Edu_Project.Models.FinalGrade

@{
    ViewData["Title"] = "Final Exam Result";

    var finalExam =
        ViewBag.FinalExam as Edu_Project.Models.FinalExam;

    var totalMarks =
        finalExam?.TotalMarks ?? 0;

    var percentage =
        totalMarks == 0
            ? 0
            : (Model.Grade * 100) / totalMarks;

    var passed =
        percentage >= 50;
}

<section class="edu-page-section">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-8">

                <div class="quiz-result-card">

                    <div class="quiz-result-header @(passed ? "passed" : "failed")">

                        <div class="quiz-result-status-icon">
                            @(passed ? "✓" : "!")
                        </div>

                        <span class="dashboard-panel-label">
                            Final Exam Result
                        </span>

                        <h1>
                            @(passed
                                ? "Congratulations!"
                                : "Final Exam Completed")
                        </h1>

                        <p>
                            @(passed
                                ? "You successfully passed the final exam."
                                : "You completed the final exam, but your score is below the passing mark.")
                        </p>

                    </div>

                    <div class="quiz-result-body">

                        @if (finalExam?.course != null)
                        {
                            <div class="quiz-result-title">

                                <span>
                                    Course
                                </span>

                                <h2>
                                    @finalExam.course.Title
                                </h2>

                            </div>
                        }
                        else if (finalExam != null)
                        {
                            <div class="quiz-result-title">

                                <span>
                                    Final Exam
                                </span>

                                <h2>
                                    @finalExam.Title
                                </h2>

                            </div>
                        }

                        <div class="quiz-result-score-area">

                            <div class="quiz-result-score-circle @(passed ? "passed" : "failed")">

                                <span class="quiz-result-percentage">
                                    @percentage%
                                </span>

                                <span class="quiz-result-score-label">
                                    Final Score
                                </span>

                            </div>

                            <div class="quiz-result-score-details">

                                <div class="quiz-result-score-item">

                                    <span>
                                        Your Grade
                                    </span>

                                    <strong>
                                        @Model.Grade
                                    </strong>

                                </div>

                                <div class="quiz-result-score-item">

                                    <span>
                                        Total Marks
                                    </span>

                                    <strong>
                                        @totalMarks
                                    </strong>

                                </div>

                                <div class="quiz-result-score-item">

                                    <span>
                                        Result
                                    </span>

                                    <strong class="@(passed ? "quiz-result-pass-text" : "quiz-result-fail-text")">
                                        @(passed ? "Passed" : "Not Passed")
                                    </strong>

                                </div>

                            </div>

                        </div>

                        <div class="quiz-result-message @(passed ? "passed" : "failed")">

                            <div class="quiz-result-message-icon">
                                @(passed ? "✓" : "!")
                            </div>

                            <div>

                                <strong>
                                    @(passed
                                        ? "Course exam completed successfully"
                                        : "Keep improving")
                                </strong>

                                <p>
                                    @(passed
                                        ? "You achieved the required passing score for the final exam."
                                        : "Review the course lessons and quizzes to strengthen your understanding.")
                                </p>

                            </div>

                        </div>

                        <div class="quiz-result-actions">

                            <a asp-controller="FinalExam"
                               asp-action="MyFinalGrades"
                               class="btn edu-btn-primary">

                                My Final Grades

                            </a>

                            <a asp-controller="Enrollment"
                               asp-action="MyCourses"
                               class="btn edu-btn-outline">

                                Back to My Courses

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>