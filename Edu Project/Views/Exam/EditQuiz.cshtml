@model Edu_Project.Models.Quiz

@{
    ViewData["Title"] = "Edit Quiz";
}

<section class="edu-page-section">

    <div class="container">

        <div class="edu-page-header">

            <span class="edu-hero-badge">
                Quiz Management
            </span>

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3">

                <div>

                    <h1 class="edu-page-title">
                        Edit Quiz
                    </h1>

                    <p class="edu-page-subtitle mb-0">
                        Update quiz information and review its questions and answers.
                    </p>

                </div>

                <a asp-action="QuizDetails"
                   asp-route-id="@Model.LessonId"
                   class="btn edu-btn-outline">

                    Back to Quiz

                </a>

            </div>

        </div>

        <form asp-action="EditQuiz"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Id" />

            <input type="hidden"
                   asp-for="LessonId" />

            <div class="row g-4">

                <div class="col-xl-4">

                    <div class="quiz-edit-info-card">

                        <span class="dashboard-panel-label">
                            Quiz Information
                        </span>

                        <h2>
                            Basic Details
                        </h2>

                        <p>
                            Update the quiz title, marks and duration.
                        </p>

                        <div asp-validation-summary="All"
                             class="alert alert-danger">
                        </div>

                        <div class="mb-4">

                            <label asp-for="Title"
                                   class="form-label">
                                Quiz Title
                            </label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="Quiz title"
                                   required />

                            <span asp-validation-for="Title"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="TotalMarks"
                                   class="form-label">
                                Total Marks
                            </label>

                            <input asp-for="TotalMarks"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   required />

                            <span asp-validation-for="TotalMarks"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Duration"
                                   class="form-label">
                                Duration
                            </label>

                            <div class="input-group">

                                <input asp-for="Duration"
                                       type="number"
                                       min="1"
                                       class="form-control"
                                       required />

                                <span class="input-group-text">
                                    minutes
                                </span>

                            </div>

                            <span asp-validation-for="Duration"
                                  class="text-danger small">
                            </span>

                        </div>

                        <button type="submit"
                                class="btn edu-btn-primary w-100">

                            Save Quiz Changes
                            <span class="ms-1">
                                →
                            </span>

                        </button>

                    </div>

                </div>

                <div class="col-xl-8">

                    <div class="quiz-edit-questions-card">

                        <div class="quiz-edit-section-header">

                            <div>

                                <span class="dashboard-panel-label">
                                    Quiz Content
                                </span>

                                <h2>
                                    Questions
                                </h2>

                                <p>
                                    Review and edit the questions and answer text.
                                </p>

                            </div>

                            <span class="quiz-question-count">
                                @(Model.Questions?.Count ?? 0)
                                Question@(Model.Questions?.Count == 1 ? "" : "s")
                            </span>

                        </div>

                        @if (Model.Questions != null &&
                             Model.Questions.Any())
                        {
                            var questions =
                                Model.Questions.ToList();

                            <div class="quiz-edit-question-list">

                                @for (int i = 0;
                                      i < questions.Count;
                                      i++)
                                {
                                    var question =
                                        questions[i];

                                    var answers =
                                        question.Answers?
                                            .ToList()
                                        ?? new List<Edu_Project.Models.Answer>();

                                    <div class="quiz-edit-question">

                                        <div class="quiz-edit-question-header">

                                            <div class="quiz-question-number">
                                                @(i + 1)
                                            </div>

                                            <div>

                                                <span class="quiz-question-label">
                                                    Question @(i + 1)
                                                </span>

                                                <strong>
                                                    Edit Question
                                                </strong>

                                            </div>

                                        </div>

                                        <input type="hidden"
                                               name="Questions[@i].Id"
                                               value="@question.Id" />

                                        <div class="mb-3">

                                            <label class="form-label">
                                                Question Text
                                            </label>

                                            <input type="text"
                                                   name="Questions[@i].Text"
                                                   value="@question.Text"
                                                   class="form-control"
                                                   required />

                                        </div>

                                        <div class="quiz-edit-answer-grid">

                                            @for (int j = 0;
                                                  j < answers.Count;
                                                  j++)
                                            {
                                                var answer =
                                                    answers[j];

                                                <div class="quiz-edit-answer @(answer.IsCorrect ? "correct" : "")">

                                                    <input type="hidden"
                                                           name="Questions[@i].Answers[@j].Id"
                                                           value="@answer.Id" />

                                                    <input type="hidden"
                                                           name="Questions[@i].Answers[@j].IsCorrect"
                                                           value="@answer.IsCorrect.ToString().ToLower()" />

                                                    <div class="quiz-edit-answer-top">

                                                        <span class="quiz-answer-letter">

                                                            @if (j == 0)
                                                            {
                                                                <span>A</span>
                                                            }
                                                            else if (j == 1)
                                                            {
                                                                <span>B</span>
                                                            }
                                                            else if (j == 2)
                                                            {
                                                                <span>C</span>
                                                            }
                                                            else
                                                            {
                                                                <span>D</span>
                                                            }

                                                        </span>

                                                        @if (answer.IsCorrect)
                                                        {
                                                            <span class="quiz-correct-badge">
                                                                Correct
                                                            </span>
                                                        }

                                                    </div>

                                                    <input type="text"
                                                           name="Questions[@i].Answers[@j].Text"
                                                           value="@answer.Text"
                                                           class="form-control"
                                                           required />

                                                </div>
                                            }

                                        </div>

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="dashboard-empty-state">

                                <div class="dashboard-empty-icon">
                                    Q
                                </div>

                                <h4>
                                    No questions found
                                </h4>

                                <p>
                                    There are no questions available for this quiz.
                                </p>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </form>

    </div>

</section>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}