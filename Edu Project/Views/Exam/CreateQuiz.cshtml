@model Edu_Project.Models.QuizVM

@{
    ViewData["Title"] = "Create Quiz";
}

<section class="edu-page-section">

    <div class="container">

        <div class="edu-page-header">

            <span class="edu-hero-badge">
                Quiz Management
            </span>

            <div>

                <h1 class="edu-page-title">
                    Create Quiz
                </h1>

                <p class="edu-page-subtitle mb-0">
                    Configure the quiz and choose how many questions it will contain.
                </p>

            </div>

        </div>

        <div class="row justify-content-center">

            <div class="col-xl-9">

                <div class="lesson-form-card">

                    <div class="lesson-form-header">

                        <div class="lesson-form-icon">
                            Q
                        </div>

                        <div>

                            <span class="dashboard-panel-label">
                                New Quiz
                            </span>

                            <h2>
                                Quiz Information
                            </h2>

                            <p>
                                Set the title, duration, marks and number of questions.
                            </p>

                        </div>

                    </div>

                    <form asp-action="CreateQuiz"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="lessonid" />

                        <div asp-validation-summary="All"
                             class="alert alert-danger mb-4">
                        </div>

                        <div class="row g-4">

                            <div class="col-12">

                                <label asp-for="Title"
                                       class="form-label">
                                    Quiz Title
                                </label>

                                <input asp-for="Title"
                                       class="form-control"
                                       placeholder="Example: Cyber Security Basics Quiz"
                                       required />

                                <span asp-validation-for="Title"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-4">

                                <label asp-for="duration"
                                       class="form-label">
                                    Duration
                                </label>

                                <div class="input-group">

                                    <input asp-for="duration"
                                           type="number"
                                           min="1"
                                           class="form-control"
                                           placeholder="10"
                                           required />

                                    <span class="input-group-text">
                                        minutes
                                    </span>

                                </div>

                                <span asp-validation-for="duration"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-4">

                                <label asp-for="totalmarks"
                                       class="form-label">
                                    Total Marks
                                </label>

                                <input asp-for="totalmarks"
                                       type="number"
                                       min="1"
                                       class="form-control"
                                       placeholder="5"
                                       required />

                                <span asp-validation-for="totalmarks"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-4">

                                <label asp-for="numberOfQuestions"
                                       class="form-label">
                                    Number of Questions
                                </label>

                                <input asp-for="numberOfQuestions"
                                       type="number"
                                       min="1"
                                       max="50"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="numberOfQuestions"
                                      class="text-danger small">
                                </span>

                                <div class="form-text">
                                    Choose between 1 and 50 questions.
                                </div>

                            </div>

                        </div>

                        <div class="lesson-form-next">

                            <div>

                                <span class="lesson-form-next-label">
                                    Next Step
                                </span>

                                <strong>
                                    Add Quiz Questions
                                </strong>

                                <p>
                                    The question builder will open with the number of questions you selected.
                                </p>

                            </div>

                            <button type="submit"
                                    class="btn edu-btn-primary">

                                Add Questions
                                <span class="ms-1">
                                    →
                                </span>

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}