@model Edu_Project.Models.Quiz

@{
    ViewData["Title"] = "Quiz Details";
}

<section class="edu-page-section">

    <div class="container">

        <div class="edu-page-header">

            <span class="edu-hero-badge">
                Quiz Management
            </span>

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3">

                <div>

                    <h1 class="edu-page-title">
                        @Model.Title
                    </h1>

                    <p class="edu-page-subtitle mb-0">
                        Review quiz information, questions and correct answers.
                    </p>

                </div>

                <div class="d-flex gap-2 flex-wrap">

                    <a asp-action="EditQuiz"
                       asp-route-id="@Model.Id"
                       class="btn edu-btn-primary">

                        Edit Quiz

                    </a>

                    <a asp-controller="Lesson"
                       asp-action="LessonDetailsForInstructor"
                       asp-route-id="@Model.Lesson?.CourseId"
                       class="btn edu-btn-outline">

                        Back to Lessons

                    </a>

                </div>

            </div>

        </div>

        <div class="quiz-details-summary">

            <div class="quiz-summary-main">

                <div class="quiz-summary-icon">
                    Q
                </div>

                <div>

                    <span class="dashboard-panel-label">
                        Quiz Overview
                    </span>

                    <h2>
                        @Model.Title
                    </h2>

                    <p>
                        This quiz contains
                        @(Model.Questions?.Count ?? 0)
                        question@(Model.Questions?.Count == 1 ? "" : "s").
                    </p>

                </div>

            </div>

            <div class="quiz-summary-stats">

                <div class="quiz-summary-stat">

                    <span>
                        Duration
                    </span>

                    <strong>
                        @Model.Duration min
                    </strong>

                </div>

                <div class="quiz-summary-stat">

                    <span>
                        Total Marks
                    </span>

                    <strong>
                        @Model.TotalMarks
                    </strong>

                </div>

                <div class="quiz-summary-stat">

                    <span>
                        Questions
                    </span>

                    <strong>
                        @(Model.Questions?.Count ?? 0)
                    </strong>

                </div>

            </div>

        </div>

        <div class="quiz-questions-header">

            <div>

                <span class="dashboard-panel-label">
                    Question List
                </span>

                <h2>
                    Questions
                </h2>

                <p>
                    Correct answers are highlighted below.
                </p>

            </div>

        </div>

        @if (Model.Questions != null &&
             Model.Questions.Any())
        {
            var questionNumber = 1;

            <div class="quiz-question-list">

                @foreach (var question in Model.Questions)
                {
                    <div class="quiz-question-card">

                        <div class="quiz-question-number">
                            @questionNumber
                        </div>

                        <div class="quiz-question-content">

                            <span class="quiz-question-label">
                                Question @questionNumber
                            </span>

                            <h3>
                                @question.Text
                            </h3>

                            @if (question.Answers != null &&
                                 question.Answers.Any())
                            {
                                <div class="quiz-answer-list">

                                    @{
                                        var answerNumber = 1;
                                    }

                                    @foreach (var answer in question.Answers)
                                    {
                                        <div class="quiz-answer-item @(answer.IsCorrect ? "correct" : "")">

                                            <div class="quiz-answer-letter">

                                                @if (answerNumber == 1)
                                                {
                                                    <span>A</span>
                                                }
                                                else if (answerNumber == 2)
                                                {
                                                    <span>B</span>
                                                }
                                                else if (answerNumber == 3)
                                                {
                                                    <span>C</span>
                                                }
                                                else
                                                {
                                                    <span>D</span>
                                                }

                                            </div>

                                            <span class="quiz-answer-text">
                                                @answer.Text
                                            </span>

                                            @if (answer.IsCorrect)
                                            {
                                                <span class="quiz-correct-badge">
                                                    Correct Answer
                                                </span>
                                            }

                                        </div>

                                        answerNumber++;
                                    }

                                </div>
                            }
                            else
                            {
                                <div class="quiz-no-answers">
                                    No answers found for this question.
                                </div>
                            }

                        </div>

                    </div>

                    questionNumber++;
                }

            </div>
        }
        else
        {
            <div class="dashboard-panel">

                <div class="dashboard-empty-state">

                    <div class="dashboard-empty-icon">
                        Q
                    </div>

                    <h4>
                        No questions found
                    </h4>

                    <p>
                        This quiz does not contain any questions yet.
                    </p>

                </div>

            </div>
        }

    </div>

</section>