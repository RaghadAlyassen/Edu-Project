@{
    ViewData["Title"] = "Student Dashboard";

    var student =
        ViewBag.Student as Edu_Project.Models.Student;
}

<section class="edu-page-section">

    <div class="container">

        <div class="edu-page-header">

            <span class="edu-hero-badge">
                Student Portal
            </span>

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3">

                <div>

                    <h1 class="edu-page-title">
                        Welcome Back
                    </h1>

                    <p class="edu-page-subtitle mb-0">
                        Continue learning, track your progress and review your grades.
                    </p>

                </div>

                <div class="student-profile-mini">

                    <div class="student-profile-avatar">

                        @if (!string.IsNullOrWhiteSpace(student?.Email))
                        {
                            @(student.Email.Substring(0, 1).ToUpper())
                        }
                        else
                        {
                            <span>S</span>
                        }

                    </div>

                    <div>

                        <span>
                            Student Account
                        </span>

                        <strong>
                            @(student?.Email ?? "Student")
                        </strong>

                    </div>

                </div>

            </div>

        </div>

        <div class="row g-4 mb-5">

            <div class="col-md-6 col-xl-3">

                <div class="edu-stat-card student-stat-card">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="edu-stat-label">
                                Enrolled Courses
                            </div>

                            <div class="edu-stat-value">
                                @ViewBag.EnrolledCoursesCount
                            </div>

                        </div>

                        <div class="dashboard-stat-icon">
                            C
                        </div>

                    </div>

                    <p class="dashboard-stat-text mb-0">
                        Courses you are currently enrolled in.
                    </p>

                </div>

            </div>

            <div class="col-md-6 col-xl-3">

                <div class="edu-stat-card student-stat-card">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="edu-stat-label">
                                Watched Lessons
                            </div>

                            <div class="edu-stat-value">
                                @ViewBag.WatchedLessonsCount
                            </div>

                        </div>

                        <div class="dashboard-stat-icon">
                            L
                        </div>

                    </div>

                    <p class="dashboard-stat-text mb-0">
                        Lessons you have already completed.
                    </p>

                </div>

            </div>

            <div class="col-md-6 col-xl-3">

                <div class="edu-stat-card student-stat-card">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="edu-stat-label">
                                Completed Quizzes
                            </div>

                            <div class="edu-stat-value">
                                @ViewBag.QuizGradesCount
                            </div>

                        </div>

                        <div class="dashboard-stat-icon">
                            Q
                        </div>

                    </div>

                    <p class="dashboard-stat-text mb-0">
                        Quizzes completed during your courses.
                    </p>

                </div>

            </div>

            <div class="col-md-6 col-xl-3">

                <div class="edu-stat-card student-stat-card">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="edu-stat-label">
                                Final Exams
                            </div>

                            <div class="edu-stat-value">
                                @ViewBag.FinalGradesCount
                            </div>

                        </div>

                        <div class="dashboard-stat-icon">
                            F
                        </div>

                    </div>

                    <p class="dashboard-stat-text mb-0">
                        Final exams you have already completed.
                    </p>

                </div>

            </div>

        </div>

        <div class="row g-4">

            <div class="col-xl-8">

                <div class="dashboard-panel">

                    <div class="dashboard-panel-header">

                        <div>

                            <span class="dashboard-panel-label">
                                Learning Center
                            </span>

                            <h2 class="dashboard-panel-title">
                                Continue Your Learning
                            </h2>

                            <p class="dashboard-panel-subtitle">
                                Access courses, lessons and your learning progress.
                            </p>

                        </div>

                    </div>

                    <div class="student-action-grid">

                        <a asp-controller="Enrollment"
                           asp-action="Courses"
                           class="student-action-card">

                            <div class="student-action-icon">
                                C
                            </div>

                            <div>

                                <span class="student-action-label">
                                    Discover
                                </span>

                                <h3>
                                    Browse Courses
                                </h3>

                                <p>
                                    Explore available courses and enroll in new learning content.
                                </p>

                            </div>

                            <span class="student-action-arrow">
                                →
                            </span>

                        </a>

                        <a asp-controller="Enrollment"
                           asp-action="MyCourses"
                           class="student-action-card">

                            <div class="student-action-icon">
                                M
                            </div>

                            <div>

                                <span class="student-action-label">
                                    Learning
                                </span>

                                <h3>
                                    My Courses
                                </h3>

                                <p>
                                    Continue your enrolled courses and access their lessons.
                                </p>

                            </div>

                            <span class="student-action-arrow">
                                →
                            </span>

                        </a>

                        <a asp-controller="Quiz"
                           asp-action="MyGrades"
                           class="student-action-card">

                            <div class="student-action-icon">
                                Q
                            </div>

                            <div>

                                <span class="student-action-label">
                                    Performance
                                </span>

                                <h3>
                                    Quiz Grades
                                </h3>

                                <p>
                                    Review your quiz results and track your course performance.
                                </p>

                            </div>

                            <span class="student-action-arrow">
                                →
                            </span>

                        </a>

                        <a asp-controller="FinalExam"
                           asp-action="MyFinalGrades"
                           class="student-action-card">

                            <div class="student-action-icon">
                                F
                            </div>

                            <div>

                                <span class="student-action-label">
                                    Results
                                </span>

                                <h3>
                                    Final Grades
                                </h3>

                                <p>
                                    Review your completed final exams and final course results.
                                </p>

                            </div>

                            <span class="student-action-arrow">
                                →
                            </span>

                        </a>

                    </div>

                </div>

            </div>

            <div class="col-xl-4">

                <div class="student-progress-card">

                    <span class="dashboard-panel-label">
                        Your Progress
                    </span>

                    <h2>
                        Learning Summary
                    </h2>

                    <p>
                        A quick overview of your activity on the platform.
                    </p>

                    <div class="student-progress-list">

                        <div class="student-progress-item">

                            <div>

                                <span>
                                    Courses
                                </span>

                                <strong>
                                    @ViewBag.EnrolledCoursesCount enrolled
                                </strong>

                            </div>

                            <div class="student-progress-circle">
                                C
                            </div>

                        </div>

                        <div class="student-progress-item">

                            <div>

                                <span>
                                    Lessons
                                </span>

                                <strong>
                                    @ViewBag.WatchedLessonsCount watched
                                </strong>

                            </div>

                            <div class="student-progress-circle">
                                L
                            </div>

                        </div>

                        <div class="student-progress-item">

                            <div>

                                <span>
                                    Quizzes
                                </span>

                                <strong>
                                    @ViewBag.QuizGradesCount completed
                                </strong>

                            </div>

                            <div class="student-progress-circle">
                                Q
                            </div>

                        </div>

                        <div class="student-progress-item">

                            <div>

                                <span>
                                    Final Exams
                                </span>

                                <strong>
                                    @ViewBag.FinalGradesCount completed
                                </strong>

                            </div>

                            <div class="student-progress-circle">
                                F
                            </div>

                        </div>

                    </div>

                    <a asp-controller="Enrollment"
                       asp-action="MyCourses"
                       class="btn edu-btn-primary w-100 mt-4">

                        Continue Learning
                        <span class="ms-1">
                            →
                        </span>

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>