@{
    ViewData["Title"] = "Student Dashboard";

    var student =
        ViewBag.Student as Edu_Project.Models.Student;
}

<div class="container mt-4">

    <div class="mb-4">

        <h2>
            Student Dashboard
        </h2>

        <p class="text-muted">
            Welcome,
            @(student?.Email ?? "Student")
        </p>

    </div>

    <div class="row mb-4">

        <div class="col-md-3 mb-3">

            <div class="card shadow-sm h-100 text-center">

                <div class="card-body">

                    <h3 class="text-primary">
                        @ViewBag.EnrolledCoursesCount
                    </h3>

                    <p class="mb-0">
                        Enrolled Courses
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-3 mb-3">

            <div class="card shadow-sm h-100 text-center">

                <div class="card-body">

                    <h3 class="text-success">
                        @ViewBag.WatchedLessonsCount
                    </h3>

                    <p class="mb-0">
                        Watched Lessons
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-3 mb-3">

            <div class="card shadow-sm h-100 text-center">

                <div class="card-body">

                    <h3 class="text-warning">
                        @ViewBag.QuizGradesCount
                    </h3>

                    <p class="mb-0">
                        Completed Quizzes
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-3 mb-3">

            <div class="card shadow-sm h-100 text-center">

                <div class="card-body">

                    <h3 class="text-danger">
                        @ViewBag.FinalGradesCount
                    </h3>

                    <p class="mb-0">
                        Final Exams
                    </p>

                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <h4 class="mb-4">
                Student Actions
            </h4>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <a asp-controller="Enrollment"
                       asp-action="Courses"
                       class="btn btn-primary w-100 p-3">

                        Browse Courses

                    </a>

                </div>

                <div class="col-md-6 mb-3">

                    <a asp-controller="Enrollment"
                       asp-action="MyCourses"
                       class="btn btn-outline-primary w-100 p-3">

                        My Courses

                    </a>

                </div>

                <div class="col-md-6 mb-3">

                    <a asp-controller="Quiz"
                       asp-action="MyGrades"
                       class="btn btn-outline-success w-100 p-3">

                        My Quiz Grades

                    </a>

                </div>

                <div class="col-md-6 mb-3">

                    <a asp-controller="FinalExam"
                       asp-action="MyFinalGrades"
                       class="btn btn-outline-warning w-100 p-3">

                        My Final Grades

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>