@model Edu_Project.Models.Instructor

@{
    ViewData["Title"] = "Delete Instructor";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Delete Instructor</h4>
                </div>
                <div class="card-body">
                    <h5 class="text-danger mb-4">Are you sure you want to delete this instructor?</h5>

                    <dl class="row">
                        <dt class="col-sm-4 fw-bold">User Name:</dt>
                        <dd class="col-sm-8">@Model.UserName</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-danger">Confirm Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>