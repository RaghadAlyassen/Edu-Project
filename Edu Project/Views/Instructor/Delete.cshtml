@model Edu_Project.Models.Instructor

@{
    ViewData["Title"] = "Delete Instructor";
}

<section class="edu-page-section">

    <div class="container">

        <div class="edu-page-header">

            <span class="edu-hero-badge">
                Instructor Management
            </span>

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3">

                <div>

                    <h1 class="edu-page-title">
                        Delete Instructor
                    </h1>

                    <p class="edu-page-subtitle mb-0">
                        Review the instructor information before confirming deletion.
                    </p>

                </div>

                <a asp-action="Index"
                   class="btn edu-btn-outline">

                    Back to Dashboard

                </a>

            </div>

        </div>

        <div class="row justify-content-center">

            <div class="col-xl-7">

                <div class="delete-instructor-card">

                    <div class="delete-instructor-header">

                        <div class="delete-instructor-icon">
                            !
                        </div>

                        <div>

                            <span class="delete-instructor-label">
                                Delete Account
                            </span>

                            <h2>
                                Are you sure?
                            </h2>

                            <p>
                                You are about to delete this instructor account.
                            </p>

                        </div>

                    </div>

                    <div class="delete-instructor-profile">

                        @if (!string.IsNullOrWhiteSpace(Model.ProfileImg))
                        {
                            <img src="@Model.ProfileImg"
                                 alt="@Model.UserName"
                                 class="delete-instructor-image" />
                        }
                        else
                        {
                            <div class="delete-instructor-image delete-instructor-placeholder">

                                @if (!string.IsNullOrWhiteSpace(Model.UserName))
                                {
                                    @(Model.UserName.Substring(0, 1).ToUpper())
                                }
                                else
                                {
                                    <span>I</span>
                                }

                            </div>
                        }

                        <div>

                            <span>
                                Instructor
                            </span>

                            <h3>
                                @(Model.UserName ?? "Instructor")
                            </h3>

                            <p>
                                @(Model.Email ?? "No email available")
                            </p>

                        </div>

                    </div>

                    <div class="delete-instructor-details">

                        <div>

                            <span>
                                User Name
                            </span>

                            <strong>
                                @(Model.UserName ?? "N/A")
                            </strong>

                        </div>

                        <div>

                            <span>
                                Specialization
                            </span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Specialization)
                                    ? "Not specified"
                                    : Model.Specialization)
                            </strong>

                        </div>

                    </div>

                    <div class="delete-warning-box">

                        <div class="delete-warning-icon">
                            !
                        </div>

                        <div>

                            <strong>
                                This action cannot be undone
                            </strong>

                            <p>
                                Confirm only if you really want to remove this instructor account.
                            </p>

                        </div>

                    </div>

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />

                        <div class="delete-instructor-actions">

                            <a asp-action="Index"
                               class="btn edu-btn-outline">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn delete-confirm-button">

                                Confirm Delete

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>