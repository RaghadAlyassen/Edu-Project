@model IEnumerable<Edu_Project.Models.Instructor>

@{
    ViewData["Title"] = "Instructor Dashboard";

    var courses = ViewBag.Courses as IEnumerable<Edu_Project.Models.Course>;
    var categories = ViewBag.Categories as IEnumerable<Edu_Project.Models.Category>;

    var coursesCount = courses?.Count() ?? 0;
    var categoriesCount = categories?.Count() ?? 0;
    var instructorsCount = Model?.Count() ?? 0;
}

<section class="edu-page-section">

    <div class="container">

        <div class="edu-page-header">

            <span class="edu-hero-badge">
                Instructor Portal
            </span>

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3">

                <div>

                    <h1 class="edu-page-title">
                        Welcome to your Dashboard
                    </h1>

                    <p class="edu-page-subtitle mb-0">

                        Manage courses, categories and learning content from one place.

                    </p>

                </div>

                <div class="d-flex gap-2 flex-wrap">

                    <a asp-controller="Course"
                       asp-action="Create"
                       class="btn edu-btn-primary">

                        Create Course
                        <span class="ms-1">
                            →
                        </span>

                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Instructor"
                           asp-action="Create"
                           class="btn edu-btn-outline">

                            Create Instructor

                        </a>
                    }

                </div>

            </div>

        </div>

        <div class="row g-4 mb-5">

            <div class="col-md-6 col-xl-4">

                <div class="edu-stat-card">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="edu-stat-label">
                                Total Courses
                            </div>

                            <div class="edu-stat-value">
                                @coursesCount
                            </div>

                        </div>

                        <div class="dashboard-stat-icon">
                            C
                        </div>

                    </div>

                    <p class="dashboard-stat-text mb-0">
                        Courses currently available in your dashboard.
                    </p>

                </div>

            </div>

            <div class="col-md-6 col-xl-4">

                <div class="edu-stat-card">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="edu-stat-label">
                                Categories
                            </div>

                            <div class="edu-stat-value">
                                @categoriesCount
                            </div>

                        </div>

                        <div class="dashboard-stat-icon">
                            G
                        </div>

                    </div>

                    <p class="dashboard-stat-text mb-0">
                        Categories related to available learning content.
                    </p>

                </div>

            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="col-md-6 col-xl-4">

                    <div class="edu-stat-card">

                        <div class="d-flex justify-content-between align-items-start">

                            <div>

                                <div class="edu-stat-label">
                                    Instructors
                                </div>

                                <div class="edu-stat-value">
                                    @instructorsCount
                                </div>

                            </div>

                            <div class="dashboard-stat-icon">
                                I
                            </div>

                        </div>

                        <p class="dashboard-stat-text mb-0">
                            Registered instructors on the platform.
                        </p>

                    </div>

                </div>
            }

        </div>

        <div class="row g-4">

            <div class="col-xl-8">

                <div class="dashboard-panel">

                    <div class="dashboard-panel-header">

                        <div>

                            <span class="dashboard-panel-label">
                                Course Management
                            </span>

                            <h2 class="dashboard-panel-title">
                                My Courses
                            </h2>

                            <p class="dashboard-panel-subtitle">
                                Review and manage your current courses.
                            </p>

                        </div>

                        <a asp-controller="Course"
                           asp-action="Index"
                           class="dashboard-view-link">

                            View all
                            <span>
                                →
                            </span>

                        </a>

                    </div>

                    @if (courses != null && courses.Any())
                    {
                        <div class="dashboard-course-list">

                            @foreach (var course in courses)
                            {
                                <div class="dashboard-course-item">

                                    <div class="dashboard-course-main">

                                        <div class="dashboard-course-avatar">

                                            @if (!string.IsNullOrWhiteSpace(course.Title))
                                            {
                                                @(course.Title.Substring(0, 1).ToUpper())
                                            }
                                            else
                                            {
                                                <span>C</span>
                                            }

                                        </div>

                                        <div>

                                            <span class="edu-course-category">
                                                @(course.Category?.Name ?? "Uncategorized")
                                            </span>

                                            <h3 class="dashboard-course-title">
                                                @course.Title
                                            </h3>

                                            <p class="dashboard-course-meta mb-0">

                                                Instructor:
                                                <strong>
                                                    @(course.Instructor?.UserName ?? "N/A")
                                                </strong>

                                            </p>

                                        </div>

                                    </div>

                                    <div class="dashboard-course-actions">

                                        <a asp-controller="Course"
                                           asp-action="Details"
                                           asp-route-id="@course.Id"
                                           class="btn edu-btn-outline">

                                            Details

                                        </a>

                                        <a asp-controller="Course"
                                           asp-action="Edit"
                                           asp-route-id="@course.Id"
                                           class="btn edu-btn-primary">

                                            Edit

                                        </a>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="dashboard-empty-state">

                            <div class="dashboard-empty-icon">
                                C
                            </div>

                            <h4>
                                No courses yet
                            </h4>

                            <p>
                                Create your first course and start adding lessons and exams.
                            </p>

                            <a asp-controller="Course"
                               asp-action="Create"
                               class="btn edu-btn-primary">

                                Create Course

                            </a>

                        </div>
                    }

                </div>

            </div>

            <div class="col-xl-4">

                <div class="dashboard-panel h-100">

                    <div class="dashboard-panel-header">

                        <div>

                            <span class="dashboard-panel-label">
                                Organization
                            </span>

                            <h2 class="dashboard-panel-title">
                                Categories
                            </h2>

                            <p class="dashboard-panel-subtitle">
                                Browse categories available for your specialization.
                            </p>

                        </div>

                    </div>

                    @if (categories != null && categories.Any())
                    {
                        <div class="dashboard-category-list">

                            @foreach (var cat in categories)
                            {
                                <div class="dashboard-category-item">

                                    <div class="dashboard-category-icon">

                                        @if (!string.IsNullOrWhiteSpace(cat.Name))
                                        {
                                            @(cat.Name.Substring(0, 1).ToUpper())
                                        }
                                        else
                                        {
                                            <span>C</span>
                                        }

                                    </div>

                                    <div class="dashboard-category-content">

                                        <h4>
                                            @cat.Name
                                        </h4>

                                        @if (!string.IsNullOrWhiteSpace(cat.Description))
                                        {
                                            <p>
                                                @cat.Description
                                            </p>
                                        }

                                    </div>

                                    <div class="dropdown">

                                        <button class="dashboard-menu-button"
                                                type="button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false">

                                            ⋮

                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end edu-dropdown">

                                            <li>

                                                <a class="dropdown-item"
                                                   asp-controller="Category"
                                                   asp-action="Details"
                                                   asp-route-id="@cat.Id">

                                                    Details

                                                </a>

                                            </li>

                                            @if (User.IsInRole("Admin"))
                                            {
                                                <li>

                                                    <a class="dropdown-item"
                                                       asp-controller="Category"
                                                       asp-action="Edit"
                                                       asp-route-id="@cat.Id">

                                                        Edit

                                                    </a>

                                                </li>
                                            }

                                        </ul>

                                    </div>

                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="dashboard-empty-state compact">

                            <div class="dashboard-empty-icon">
                                G
                            </div>

                            <h4>
                                No categories
                            </h4>

                            <p>
                                No categories are currently available.
                            </p>

                        </div>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Category"
                           asp-action="Create"
                           class="btn edu-btn-outline w-100 mt-4">

                            Create Category

                        </a>
                    }

                </div>

            </div>

        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="dashboard-panel mt-4">

                <div class="dashboard-panel-header">

                    <div>

                        <span class="dashboard-panel-label">
                            Platform Management
                        </span>

                        <h2 class="dashboard-panel-title">
                            Instructors
                        </h2>

                        <p class="dashboard-panel-subtitle">
                            Manage instructor accounts and platform access.
                        </p>

                    </div>

                    <a asp-controller="Instructor"
                       asp-action="Create"
                       class="btn edu-btn-primary">

                        Create Instructor

                    </a>

                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">

                        <table class="table dashboard-table align-middle">

                            <thead>

                                <tr>

                                    <th>
                                        Instructor
                                    </th>

                                    <th>
                                        Specialization
                                    </th>

                                    <th class="text-end">
                                        Actions
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <td>

                                            <div class="dashboard-instructor">

                                                @if (!string.IsNullOrEmpty(item.ProfileImg))
                                                {
                                                    <img src="@item.ProfileImg"
                                                         alt="@item.UserName"
                                                         class="dashboard-instructor-image" />
                                                }
                                                else
                                                {
                                                    <div class="dashboard-instructor-image dashboard-avatar-placeholder">

                                                        @if (!string.IsNullOrWhiteSpace(item.UserName))
                                                        {
                                                            @(item.UserName.Substring(0, 1).ToUpper())
                                                        }
                                                        else
                                                        {
                                                            <span>I</span>
                                                        }

                                                    </div>
                                                }

                                                <div>

                                                    <div class="dashboard-instructor-name">
                                                        @(item.UserName ?? "Instructor")
                                                    </div>

                                                    <div class="dashboard-instructor-email">
                                                        @item.Email
                                                    </div>

                                                </div>

                                            </div>

                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(item.Specialization)
                                                ? "Not specified"
                                                : item.Specialization)
                                        </td>

                                        <td>

                                            <div class="d-flex justify-content-end gap-2 flex-wrap">

                                                <a asp-action="Details"
                                                   asp-route-id="@item.Id"
                                                   class="btn edu-btn-outline">

                                                    Details

                                                </a>

                                                <a asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="btn edu-btn-primary">

                                                    Edit

                                                </a>

                                                <a asp-action="Delete"
                                                   asp-route-id="@item.Id"
                                                   class="btn dashboard-danger-button">

                                                    Delete

                                                </a>

                                            </div>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="dashboard-empty-state">

                        <div class="dashboard-empty-icon">
                            I
                        </div>

                        <h4>
                            No instructors found
                        </h4>

                    </div>
                }

            </div>
        }

    </div>

</section>