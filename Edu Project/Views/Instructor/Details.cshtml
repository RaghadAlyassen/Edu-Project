@model Edu_Project.Models.Instructor

@{
    ViewData["Title"] = "Instructor Details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">Instructor Details</h4>
                </div>
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.ProfileImg))
                    {
                        <img src="@Model.ProfileImg" alt="Profile Image" class="rounded-circle mb-3 shadow" width="100" height="100" />
                    }
                    else
                    {
                        <div class="badge bg-secondary mb-3 p-3 rounded-circle">No Image</div>
                    }
                    <h3 class="fw-bold mb-3">@Model.UserName</h3>

                    <hr />
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>