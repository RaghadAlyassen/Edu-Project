@model Edu_Project.Models.Course

@{
    ViewData["Title"] = "Course Details";
}

<section class="edu-page-section">

    <div class="container">

        <div class="edu-page-header">

            <span class="edu-hero-badge">
                Course Details
            </span>

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3">

                <div>

                    <h1 class="edu-page-title">
                        @Model.Title
                    </h1>

                    <p class="edu-page-subtitle mb-0">
                        Review course information, manage lessons and access the final exam.
                    </p>

                </div>

                <div class="d-flex gap-2 flex-wrap">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn edu-btn-outline">

                        Edit Course

                    </a>

                    <a asp-controller="Instructor"
                       asp-action="Index"
                       class="btn edu-btn-outline">

                        Back to Dashboard

                    </a>

                </div>

            </div>

        </div>

        <div class="row g-4">

            <div class="col-xl-8">

                <div class="course-details-card">

                    <div class="course-details-hero">

                        <div class="course-details-icon">

                            @if (!string.IsNullOrWhiteSpace(Model.Title))
                            {
                                @(Model.Title.Substring(0, 1).ToUpper())
                            }
                            else
                            {
                                <span>C</span>
                            }

                        </div>

                        <div>

                            <span class="edu-course-category">
                                @(Model.Category?.Name ?? "No Category")
                            </span>

                            <h2>
                                @Model.Title
                            </h2>

                            <p>
                                @if (!string.IsNullOrWhiteSpace(Model.Descciption))
                                {
                                    @Model.Descciption
                                }
                                else
                                {
                                    <span>
                                        No description available for this course.
                                    </span>
                                }
                            </p>

                        </div>

                    </div>

                    <div class="course-details-info-grid">

                        <div class="course-details-info-item">

                            <span class="course-details-info-label">
                                Category
                            </span>

                            <strong>
                                @(Model.Category?.Name ?? "No Category")
                            </strong>

                        </div>

                        <div class="course-details-info-item">

                            <span class="course-details-info-label">
                                Instructor
                            </span>

                            <strong>
                                @(Model.Instructor?.UserName ?? "N/A")
                            </strong>

                        </div>

                        <div class="course-details-info-item">

                            <span class="course-details-info-label">
                                Price
                            </span>

                            <strong>

                                @if (Model.Price > 0)
                                {
                                    <span>
                                        @Model.Price EGP
                                    </span>
                                }
                                else
                                {
                                    <span class="course-card-free">
                                        Free
                                    </span>
                                }

                            </strong>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-4">

                <div class="course-control-card">

                    <span class="dashboard-panel-label">
                        Course Control
                    </span>

                    <h3>
                        Manage Course
                    </h3>

                    <p>
                        Manage lessons, quizzes and the final exam from here.
                    </p>

                    <div class="course-control-actions">

                        <a asp-controller="Lesson"
                           asp-action="LessonDetailsForInstructor"
                           asp-route-id="@Model.Id"
                           class="course-control-action">

                            <div class="course-control-action-icon">
                                L
                            </div>

                            <div>

                                <strong>
                                    Manage Lessons
                                </strong>

                                <span>
                                    Add, edit and review course lessons.
                                </span>

                            </div>

                            <span class="course-control-arrow">
                                →
                            </span>

                        </a>

                        @if (Model.Finalexam != null)
                        {
                            <a asp-controller="Exam"
                               asp-action="FinalDetails"
                               asp-route-id="@Model.Id"
                               class="course-control-action">

                                <div class="course-control-action-icon">
                                    F
                                </div>

                                <div>

                                    <strong>
                                        Final Exam
                                    </strong>

                                    <span>
                                        Review or manage the course final exam.
                                    </span>

                                </div>

                                <span class="course-control-arrow">
                                    →
                                </span>

                            </a>
                        }
                        else
                        {
                            <a asp-controller="Exam"
                               asp-action="CreateFinal"
                               asp-route-cid="@Model.Id"
                               class="course-control-action">

                                <div class="course-control-action-icon">
                                    +
                                </div>

                                <div>

                                    <strong>
                                        Create Final Exam
                                    </strong>

                                    <span>
                                        Create a final exam for this course.
                                    </span>

                                </div>

                                <span class="course-control-arrow">
                                    →
                                </span>

                            </a>
                        }

                    </div>

                </div>

            </div>

        </div>

        <div class="mt-4">

            <a asp-action="Index"
               class="btn edu-btn-outline">

                ← Back to Courses

            </a>

        </div>

    </div>

</section>