@model Edu_Project.Models.Course

@{
    ViewData["Title"] = "Edit Course";
}

<section class="edu-page-section">

    <div class="container">

        <div class="edu-page-header">

            <span class="edu-hero-badge">
                Course Management
            </span>

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3">

                <div>

                    <h1 class="edu-page-title">
                        Edit Course
                    </h1>

                    <p class="edu-page-subtitle mb-0">
                        Update the course information and keep its details organized.
                    </p>

                </div>

                <div class="d-flex gap-2 flex-wrap">

                    <a asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn edu-btn-outline">

                        Back to Course

                    </a>

                    <a asp-controller="Instructor"
                       asp-action="Index"
                       class="btn edu-btn-outline">

                        Back to Dashboard

                    </a>

                </div>

            </div>

        </div>

        <div class="row justify-content-center">

            <div class="col-xl-9">

                <div class="lesson-form-card">

                    <div class="lesson-form-header">

                        <div class="lesson-form-icon">
                            E
                        </div>

                        <div>

                            <span class="dashboard-panel-label">
                                Course Editor
                            </span>

                            <h2>
                                Course Information
                            </h2>

                            <p>
                                Edit the course title, description, category and price.
                            </p>

                        </div>

                    </div>

                    <form asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />

                        <input type="hidden"
                               asp-for="InstructorId" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger mb-4">
                        </div>

                        <div class="row g-4">

                            <div class="col-12">

                                <label asp-for="Title"
                                       class="form-label">
                                    Course Title
                                </label>

                                <input asp-for="Title"
                                       class="form-control"
                                       placeholder="Course title"
                                       required />

                                <span asp-validation-for="Title"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-12">

                                <label asp-for="Descciption"
                                       class="form-label">
                                    Description
                                </label>

                                <textarea asp-for="Descciption"
                                          class="form-control"
                                          rows="5"
                                          placeholder="Write the course description..."
                                          required></textarea>

                                <span asp-validation-for="Descciption"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-8">

                                <label asp-for="CategoryId"
                                       class="form-label">
                                    Category
                                </label>

                                <select asp-for="CategoryId"
                                        class="form-select"
                                        asp-items="ViewBag.Categories"
                                        required>

                                    <option value="">
                                        Select Category
                                    </option>

                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="text-danger small">
                                </span>

                                <div class="form-text">
                                    Choose a category that matches the instructor specialization.
                                </div>

                            </div>

                            <div class="col-md-4">

                                <label asp-for="Price"
                                       class="form-label">
                                    Price
                                </label>

                                <div class="input-group">

                                    <input asp-for="Price"
                                           type="number"
                                           min="0"
                                           class="form-control" />

                                    <span class="input-group-text">
                                        EGP
                                    </span>

                                </div>

                                <span asp-validation-for="Price"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="lesson-form-next">

                            <div>

                                <span class="lesson-form-next-label">
                                    Save Changes
                                </span>

                                <strong>
                                    Update Course
                                </strong>

                                <p>
                                    Save the updated course information without affecting its lessons and exams.
                                </p>

                            </div>

                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-action="Details"
                                   asp-route-id="@Model.Id"
                                   class="btn edu-btn-outline">

                                    Cancel

                                </a>

                                <button type="submit"
                                        class="btn edu-btn-primary">

                                    Save Changes
                                    <span class="ms-1">
                                        →
                                    </span>

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}