@model IEnumerable<Edu_Project.Models.Course>

@{
    ViewData["Title"] = "Courses List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Courses Management</h2>
        <a asp-action="Create" class="btn btn-primary">Create New Course</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Category</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Descciption</td>
                    <td>@(item.Category?.Name ?? "No Category")</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Details</a>
                        <a asp-controller="Instructor" asp-action="Index" class="btn btn-primary">Back to Dashboard</a>
                       
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>