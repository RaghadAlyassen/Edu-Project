@model Edu_Project.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<section class="edu-page-section">

    <div class="container">

        <div class="edu-page-header">

            <span class="edu-hero-badge">
                Category Management
            </span>

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3">

                <div>

                    <h1 class="edu-page-title">
                        Edit Category
                    </h1>

                    <p class="edu-page-subtitle mb-0">
                        Update the category name and description.
                    </p>

                </div>

                <div class="d-flex gap-2 flex-wrap">

                    <a asp-action="Index"
                       class="btn edu-btn-outline">

                        Back to Categories

                    </a>

                    <a asp-controller="Instructor"
                       asp-action="Index"
                       class="btn edu-btn-outline">

                        Back to Dashboard

                    </a>

                </div>

            </div>

        </div>

        <div class="row justify-content-center">

            <div class="col-xl-8">

                <div class="lesson-form-card">

                    <div class="lesson-form-header">

                        <div class="lesson-form-icon">
                            E
                        </div>

                        <div>

                            <span class="dashboard-panel-label">
                                Category Editor
                            </span>

                            <h2>
                                Category Information
                            </h2>

                            <p>
                                Edit the category details below and save your changes.
                            </p>

                        </div>

                    </div>

                    <form asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />

                        <div asp-validation-summary="All"
                             class="alert alert-danger mb-4">
                        </div>

                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label">
                                Category Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   autocomplete="off"
                                   placeholder="Example: Cyber Security"
                                   required />

                            <span asp-validation-for="Name"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Write a short description about this category..."
                                      required></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="lesson-form-next">

                            <div>

                                <span class="lesson-form-next-label">
                                    Save Changes
                                </span>

                                <strong>
                                    Update Category
                                </strong>

                                <p>
                                    Save the updated category information.
                                </p>

                            </div>

                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-action="Index"
                                   class="btn edu-btn-outline">

                                    Cancel

                                </a>

                                <button type="submit"
                                        class="btn edu-btn-primary">

                                    Save Changes
                                    <span class="ms-1">
                                        →
                                    </span>

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}