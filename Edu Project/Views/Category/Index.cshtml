@model IEnumerable<Edu_Project.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<section class="edu-page-section">

    <div class="container">

        <div class="edu-page-header">

            <span class="edu-hero-badge">
                Category Management
            </span>

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3">

                <div>

                    <h1 class="edu-page-title">
                        Categories
                    </h1>

                    <p class="edu-page-subtitle mb-0">
                        Browse and manage the course categories available on the platform.
                    </p>

                </div>

                <div class="d-flex gap-2 flex-wrap">

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Create"
                           class="btn edu-btn-primary">

                            Create New Category
                            <span class="ms-1">
                                →
                            </span>

                        </a>
                    }

                    <a asp-controller="Instructor"
                       asp-action="Index"
                       class="btn edu-btn-outline">

                        Back to Dashboard

                    </a>

                </div>

            </div>

        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="dashboard-panel">

                <div class="dashboard-empty-state">

                    <div class="dashboard-empty-icon">
                        G
                    </div>

                    <h4>
                        No categories found
                    </h4>

                    <p>
                        There are no categories available right now.
                    </p>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Create"
                           class="btn edu-btn-primary">

                            Create First Category

                        </a>
                    }

                </div>

            </div>
        }
        else
        {
            <div class="category-grid">

                @foreach (var item in Model)
                {
                    <div class="category-card">

                        <div class="category-card-icon">

                            @if (!string.IsNullOrWhiteSpace(item.Name))
                            {
                                @(item.Name.Substring(0, 1).ToUpper())
                            }
                            else
                            {
                                <span>G</span>
                            }

                        </div>

                        <div class="category-card-content">

                            <span class="dashboard-panel-label">
                                Course Category
                            </span>

                            <h3>
                                @item.Name
                            </h3>

                            <p>

                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    @item.Description
                                }
                                else
                                {
                                    <span>
                                        No description available for this category.
                                    </span>
                                }

                            </p>

                        </div>

                        <div class="category-card-actions">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn edu-btn-outline">

                                Details

                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn edu-btn-primary">

                                    Edit

                                </a>
                            }

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</section>