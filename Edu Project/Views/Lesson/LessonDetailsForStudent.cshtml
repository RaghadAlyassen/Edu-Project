@model List<Lesson>
@if (Model != null && Model.Any())
{
    @foreach (var i in Model)
    {
        <p>
            Title : @i.Title<br />
            description : @i.Description<br />
            order : @i.Order<br />
            video link : <a href="@i.VideoURL" target="_blank">click her</a>
        </p>
        <a asp-action="TakeQuiz" asp-controller="Exam" asp-route-lessonid="@i.Id">quiz</a>
    }

    <a asp-action="TakeFinal" asp-controller="Exam" asp-route-courseid="@Model[0].CourseId" class="btn btn-primary">take final exam</a>
}
