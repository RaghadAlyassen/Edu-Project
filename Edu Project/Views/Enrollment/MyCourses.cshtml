@model IEnumerable<Edu_Project.Models.Enrollment>

@{
    ViewData["Title"] = "My Courses";
}

<section class="edu-page-section">

    <div class="container">

        <div class="edu-page-header">

            <span class="edu-hero-badge">
                My Learning
            </span>

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3">

                <div>

                    <h1 class="edu-page-title">
                        My Courses
                    </h1>

                    <p class="edu-page-subtitle mb-0">
                        Continue your enrolled courses, access lessons and take available exams.
                    </p>

                </div>

                <a asp-controller="Enrollment"
                   asp-action="Courses"
                   class="btn edu-btn-primary">

                    Browse Courses
                    <span class="ms-1">
                        →
                    </span>

                </a>

            </div>

        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mb-4">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mb-4">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="dashboard-panel">

                <div class="dashboard-empty-state">

                    <div class="dashboard-empty-icon">
                        C
                    </div>

                    <h4>
                        No enrolled courses
                    </h4>

                    <p>
                        You are not enrolled in any courses yet.
                    </p>

                    <a asp-controller="Enrollment"
                       asp-action="Courses"
                       class="btn edu-btn-primary">

                        Browse Available Courses

                    </a>

                </div>

            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var enrollment in Model)
                {
                    <div class="col-md-6 col-xl-4">

                        <div class="edu-course-card student-course-card">

                            <div class="course-card-top">

                                <div class="course-card-icon">

                                    @if (!string.IsNullOrWhiteSpace(enrollment.Course?.Title))
                                    {
                                        @(enrollment.Course.Title.Substring(0, 1).ToUpper())
                                    }
                                    else
                                    {
                                        <span>C</span>
                                    }

                                </div>

                                <span class="student-enrolled-badge">
                                    Enrolled
                                </span>

                            </div>

                            <div class="edu-course-body">

                                <span class="edu-course-category">
                                    @(enrollment.Course?.Category?.Name ?? "General")
                                </span>

                                <h3 class="edu-course-title">
                                    @(enrollment.Course?.Title ?? "Course")
                                </h3>

                                <p class="edu-course-description">

                                    @if (!string.IsNullOrWhiteSpace(enrollment.Course?.Descciption))
                                    {
                                        @enrollment.Course.Descciption
                                    }
                                    else
                                    {
                                        <span>
                                            No description available for this course.
                                        </span>
                                    }

                                </p>

                                <div class="student-course-info">

                                    <div class="student-course-info-item">

                                        <span>
                                            Instructor
                                        </span>

                                        <strong>
                                            @(enrollment.Course?.Instructor?.UserName ?? "N/A")
                                        </strong>

                                    </div>

                                    <div class="student-course-info-item">

                                        <span>
                                            Price
                                        </span>

                                        @if (enrollment.Course != null &&
                                             enrollment.Course.Price > 0)
                                        {
                                            <strong>
                                                @enrollment.Course.Price EGP
                                            </strong>
                                        }
                                        else
                                        {
                                            <strong class="student-free-text">
                                                Free
                                            </strong>
                                        }

                                    </div>

                                    <div class="student-course-info-item">

                                        <span>
                                            Enrolled On
                                        </span>

                                        <strong>
                                            @enrollment.EnrollmentDate.ToString("dd MMM yyyy")
                                        </strong>

                                    </div>

                                    <div class="student-course-info-item">

                                        <span>
                                            Status
                                        </span>

                                        <strong class="student-free-text">
                                            Active
                                        </strong>

                                    </div>

                                </div>

                                <div class="edu-course-footer">

                                    <div class="my-course-actions">

                                        <a asp-controller="Lesson"
                                           asp-action="CourseLessons"
                                           asp-route-courseId="@enrollment.CourseId"
                                           class="btn edu-btn-primary">

                                            View Lessons

                                        </a>

                                        @if (enrollment.Course?.Finalexam != null)
                                        {
                                            <a asp-controller="FinalExam"
                                               asp-action="Take"
                                               asp-route-finalExamId="@enrollment.Course.Finalexam.Id"
                                               class="btn edu-btn-outline">

                                                Take Final Exam

                                            </a>
                                        }

                                        <form asp-controller="Enrollment"
                                              asp-action="Unenroll"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="courseId"
                                                   value="@enrollment.CourseId" />

                                            <button type="submit"
                                                    class="btn dashboard-danger-button w-100"
                                                    onclick="return confirm('Are you sure you want to unenroll from this course?');">

                                                Unenroll

                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</section>