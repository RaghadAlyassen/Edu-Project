@model IEnumerable<Edu_Project.Models.Course>

@{
    ViewData["Title"] = "Courses";

    var enrolledCourseIds =
        ViewBag.EnrolledCourseIds as List<int>
        ?? new List<int>();
}

<section class="edu-page-section">

    <div class="container">

        <div class="edu-page-header">

            <span class="edu-hero-badge">
                Course Catalog
            </span>

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3">

                <div>

                    <h1 class="edu-page-title">
                        Explore Courses
                    </h1>

                    <p class="edu-page-subtitle mb-0">
                        Browse available courses and start learning at your own pace.
                    </p>

                </div>

                <a asp-controller="Enrollment"
                   asp-action="MyCourses"
                   class="btn edu-btn-outline">

                    My Courses

                </a>

            </div>

        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mb-4">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mb-4">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="dashboard-panel">

                <div class="dashboard-empty-state">

                    <div class="dashboard-empty-icon">
                        C
                    </div>

                    <h4>
                        No courses available
                    </h4>

                    <p>
                        There are no courses available right now.
                    </p>

                </div>

            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var course in Model)
                {
                    var isEnrolled =
                        enrolledCourseIds.Contains(course.Id);

                    <div class="col-md-6 col-xl-4">

                        <div class="edu-course-card student-course-card">

                            <div class="course-card-top">

                                <div class="course-card-icon">

                                    @if (!string.IsNullOrWhiteSpace(course.Title))
                                    {
                                        @(course.Title.Substring(0, 1).ToUpper())
                                    }
                                    else
                                    {
                                        <span>C</span>
                                    }

                                </div>

                                <div class="d-flex gap-2 flex-wrap">

                                    <span class="edu-course-category">
                                        @(course.Category?.Name ?? "General")
                                    </span>

                                    @if (isEnrolled)
                                    {
                                        <span class="student-enrolled-badge">
                                            Enrolled
                                        </span>
                                    }

                                </div>

                            </div>

                            <div class="edu-course-body">

                                <h3 class="edu-course-title">
                                    @course.Title
                                </h3>

                                <p class="edu-course-description">

                                    @if (!string.IsNullOrWhiteSpace(course.Descciption))
                                    {
                                        @course.Descciption
                                    }
                                    else
                                    {
                                        <span>
                                            No description available for this course.
                                        </span>
                                    }

                                </p>

                                <div class="student-course-info">

                                    <div class="student-course-info-item">

                                        <span>
                                            Instructor
                                        </span>

                                        <strong>
                                            @(course.Instructor?.UserName ?? "N/A")
                                        </strong>

                                    </div>

                                    <div class="student-course-info-item">

                                        <span>
                                            Price
                                        </span>

                                        @if (course.Price > 0)
                                        {
                                            <strong>
                                                @course.Price EGP
                                            </strong>
                                        }
                                        else
                                        {
                                            <strong class="student-free-text">
                                                Free
                                            </strong>
                                        }

                                    </div>

                                </div>

                                <div class="edu-course-footer">

                                    @if (isEnrolled)
                                    {
                                        <div class="student-enrolled-state">

                                            <div>

                                                <span>
                                                    Course Status
                                                </span>

                                                <strong>
                                                    You are enrolled
                                                </strong>

                                            </div>

                                            <a asp-controller="Enrollment"
                                               asp-action="MyCourses"
                                               class="btn edu-btn-primary">

                                                Continue Learning

                                            </a>

                                        </div>
                                    }
                                    else
                                    {
                                        <form asp-controller="Enrollment"
                                              asp-action="Enroll"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="courseId"
                                                   value="@course.Id" />

                                            <button type="submit"
                                                    class="btn edu-btn-primary w-100">

                                                Enroll in Course
                                                <span class="ms-1">
                                                    →
                                                </span>

                                            </button>

                                        </form>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</section>