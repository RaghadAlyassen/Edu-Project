@model ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<section class="edu-page-section">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-7 col-lg-8">

                <div class="error-page-card">

                    <div class="error-page-icon">
                        !
                    </div>

                    <span class="dashboard-panel-label">
                        Something Went Wrong
                    </span>

                    <h1>
                        An Error Occurred
                    </h1>

                    <p>
                        We could not complete your request.
                        Please return to the previous page or go back to your dashboard.
                    </p>

                    @if (Model.ShowRequestId)
                    {
                        <div class="error-request-box">

                            <span>
                                Request ID
                            </span>

                            <code>
                                @Model.RequestId
                            </code>

                        </div>
                    }

                    <div class="error-page-actions">

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Student"))
                            {
                                <a asp-controller="StudentDashboard"
                                   asp-action="Index"
                                   class="btn edu-btn-primary">

                                    Back to Dashboard

                                </a>
                            }
                            else if (User.IsInRole("Instructor") ||
                                     User.IsInRole("Admin"))
                            {
                                <a asp-controller="Instructor"
                                   asp-action="Index"
                                   class="btn edu-btn-primary">

                                    Back to Dashboard

                                </a>
                            }
                        }

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn edu-btn-outline">

                            Home

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>