@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?
        .ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?
        .ToString();
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Edu Project
    </title>

    <script type="importmap"></script>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Edu_Project.styles.css"
          asp-append-version="true" />

</head>

<body>

    <header class="edu-header">

        <nav class="navbar navbar-expand-lg edu-navbar">

            <div class="container">

                <a class="navbar-brand edu-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="edu-brand-icon">
                        E
                    </span>

                    <span class="edu-brand-text">
                        EduProject
                    </span>

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav mx-auto align-items-lg-center">

                        <li class="nav-item">

                            <a class="nav-link edu-nav-link @(currentController == "Home" && currentAction == "Index" ? "edu-nav-active" : "")"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated &&
                             User.IsInRole("Student"))
                        {
                            <li class="nav-item">

                                <a class="nav-link edu-nav-link @(currentController == "StudentDashboard" ? "edu-nav-active" : "")"
                                   asp-controller="StudentDashboard"
                                   asp-action="Index">

                                    Dashboard

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link edu-nav-link @(currentController == "Enrollment" && currentAction == "Courses" ? "edu-nav-active" : "")"
                                   asp-controller="Enrollment"
                                   asp-action="Courses">

                                    Courses

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link edu-nav-link @(currentController == "Enrollment" && currentAction == "MyCourses" ? "edu-nav-active" : "")"
                                   asp-controller="Enrollment"
                                   asp-action="MyCourses">

                                    My Courses

                                </a>

                            </li>

                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle edu-nav-link @(currentController == "Quiz" || currentController == "FinalExam" ? "edu-nav-active" : "")"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    Grades

                                </a>

                                <ul class="dropdown-menu edu-dropdown">

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Quiz"
                                           asp-action="MyGrades">

                                            Quiz Grades

                                        </a>

                                    </li>

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="FinalExam"
                                           asp-action="MyFinalGrades">

                                            Final Grades

                                        </a>

                                    </li>

                                </ul>

                            </li>
                        }

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated &&
                             User.IsInRole("Instructor"))
                        {
                            <li class="nav-item">

                                <a class="nav-link edu-nav-link @(currentController == "Instructor" && currentAction == "Index" ? "edu-nav-active" : "")"
                                   asp-controller="Instructor"
                                   asp-action="Index">

                                    Dashboard

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link edu-nav-link @(currentController == "Course" ? "edu-nav-active" : "")"
                                   asp-controller="Course"
                                   asp-action="Index">

                                    My Courses

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link edu-nav-link @(currentController == "Category" ? "edu-nav-active" : "")"
                                   asp-controller="Category"
                                   asp-action="Index">

                                    Categories

                                </a>

                            </li>
                        }

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated &&
                             User.IsInRole("Admin"))
                        {
                            <li class="nav-item">

                                <a class="nav-link edu-nav-link @(currentController == "Instructor" && currentAction == "Index" ? "edu-nav-active" : "")"
                                   asp-controller="Instructor"
                                   asp-action="Index">

                                    Dashboard

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link edu-nav-link @(currentController == "Instructor" && currentAction == "Manage" ? "edu-nav-active" : "")"
                                   asp-controller="Instructor"
                                   asp-action="Manage">

                                    Instructors

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link edu-nav-link @(currentController == "Course" ? "edu-nav-active" : "")"
                                   asp-controller="Course"
                                   asp-action="Index">

                                    Courses

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link edu-nav-link @(currentController == "Category" ? "edu-nav-active" : "")"
                                   asp-controller="Category"
                                   asp-action="Index">

                                    Categories

                                </a>

                            </li>
                        }

                    </ul>

                    <div class="d-flex align-items-center gap-3">

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        {
                            <div class="edu-user">

                                <div class="edu-user-avatar">

                                    @if (!string.IsNullOrWhiteSpace(
                                        User.Identity.Name))
                                    {
                                        <span>
                                            @(User.Identity.Name
                                                .Substring(0, 1)
                                                .ToUpper())
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            U
                                        </span>
                                    }

                                </div>

                                <div class="edu-user-info">

                                    <span class="edu-user-label">
                                        Welcome
                                    </span>

                                    <span class="edu-user-name">
                                        @User.Identity.Name
                                    </span>

                                </div>

                            </div>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn edu-btn-outline">

                                    Logout

                                </button>

                            </form>
                        }
                        else
                        {
                            <a class="edu-login-link"
                               asp-controller="Account"
                               asp-action="Login">

                                Login

                            </a>

                            <a class="btn edu-btn-primary"
                               asp-controller="Account"
                               asp-action="Register">

                                Get Started

                                <span>
                                    →
                                </span>

                            </a>
                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>

    <main role="main"
          class="edu-main">

        @RenderBody()

    </main>

    <footer class="edu-footer">

        <div class="container">

            <div class="row gy-4">

                <div class="col-lg-5">

                    <a class="edu-footer-brand"
                       asp-controller="Home"
                       asp-action="Index">

                        <span class="edu-brand-icon">
                            E
                        </span>

                        EduProject

                    </a>

                    <p class="edu-footer-description">

                        Learn new skills, explore courses,
                        track your progress and achieve your
                        learning goals in one place.

                    </p>

                </div>

                <div class="col-lg-3 col-md-6">

                    <h5>
                        Quick Links
                    </h5>

                    <ul class="edu-footer-links">

                        <li>

                            <a asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated &&
                             User.IsInRole("Student"))
                        {
                            <li>

                                <a asp-controller="Enrollment"
                                   asp-action="Courses">

                                    Courses

                                </a>

                            </li>

                            <li>

                                <a asp-controller="Enrollment"
                                   asp-action="MyCourses">

                                    My Courses

                                </a>

                            </li>
                        }

                    </ul>

                </div>

                <div class="col-lg-4 col-md-6">

                    <h5>
                        Education Platform
                    </h5>

                    <p class="edu-footer-description">

                        A modern platform for students,
                        instructors and administrators.

                    </p>

                </div>

            </div>

            <div class="edu-footer-bottom">

                <span>
                    © 2026 Edu Project. All rights reserved.
                </span>

            </div>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>