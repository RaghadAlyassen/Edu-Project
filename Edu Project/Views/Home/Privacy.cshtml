@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="edu-page-section">

    <div class="container">

        <div class="edu-page-header">

            <span class="edu-hero-badge">
                Privacy
            </span>

            <div>

                <h1 class="edu-page-title">
                    Privacy Policy
                </h1>

                <p class="edu-page-subtitle mb-0">
                    Learn how EduProject handles account and learning information.
                </p>

            </div>

        </div>

        <div class="privacy-card">

            <div class="privacy-section">

                <span class="dashboard-panel-label">
                    Account Information
                </span>

                <h2>
                    Information We Use
                </h2>

                <p>
                    EduProject uses account information such as your email and role
                    to provide access to the correct platform features.
                </p>

            </div>

            <div class="privacy-section">

                <span class="dashboard-panel-label">
                    Learning Activity
                </span>

                <h2>
                    Course Progress
                </h2>

                <p>
                    The platform stores information related to enrollments,
                    watched lessons, quiz grades and final exam results so students
                    can track their learning progress.
                </p>

            </div>

            <div class="privacy-section">

                <span class="dashboard-panel-label">
                    Platform Access
                </span>

                <h2>
                    User Roles
                </h2>

                <p>
                    Students, instructors and administrators have different access
                    permissions based on their account role.
                </p>

            </div>

            <div class="privacy-section mb-0">

                <span class="dashboard-panel-label">
                    Security
                </span>

                <h2>
                    Account Protection
                </h2>

                <p>
                    Users should keep their account credentials private and avoid
                    sharing passwords with other users.
                </p>

            </div>

        </div>

        <div class="mt-4">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn edu-btn-outline">

                ← Back to Home

            </a>

        </div>

    </div>

</section>